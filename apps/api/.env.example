# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CLIENT_URLS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000


# AI Provider Selection
# Options: auto | openrouter | gemini | groq | together | mistral | mock
AI_PROVIDER=auto

# Smart Fallback AI Mode (Used when AI_PROVIDER=auto)
# Options: balanced | fast | quality | free | code
AI_MODE=balanced

# Safe fallback policy (allows final fallback to mock)
ALLOW_MOCK_FALLBACK=true

# AI Timing and Request Retry controls
AI_REQUEST_TIMEOUT_MS=90000
AI_EDIT_TIMEOUT_MS=60000
AI_MAX_RETRIES=1

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat-v3.1:free,qwen/qwen3-coder:free,google/gemini-2.0-flash-exp:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=CraftSite AI

# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Together AI Configuration
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_FALLBACK_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo,Qwen/Qwen2.5-Coder-32B-Instruct

# Mistral AI Configuration
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_FALLBACK_MODELS=mistral-large-latest,codestral-latest,mistral-small-latest

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Authentication
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Razorpay (Optional - for subscriptions/credits payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback

# Frontend Redirection links on auth success/failure
FRONTEND_AUTH_SUCCESS_URL=http://localhost:3000/dashboard
FRONTEND_AUTH_ERROR_URL=http://localhost:3000/sign-in?error=oauth_failed
